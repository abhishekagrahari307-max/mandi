# =========================================================================
#  UP MANDI ENTERPRISE v2.0 / v3.0 - PRODUCTION ENVIRONMENT CONFIGURATIONS
# =========================================================================
# Copy this file to '.env' and fill in your secure production credentials.
# Do NOT commit '.env' to public source control!

# 1. DATABASE CONFIGURATION
# Swaps seamlessly to managed PostgreSQL or MySQL on cloud (Render/AWS/Heroku)
DATABASE_URL=postgresql://mandi_user:secure_password_here@postgres-db-host:5432/mandi_db

# 2. JWT SECURITY KEY
# Generate a secure 32-character hex key (e.g. openssl rand -hex 32)
JWT_SECRET=9ef842f824b44749a978d0c17b101cff356e9

# 3. GOVERNMENT DATA API INTEGRATION
# Your personal data.gov.in API Key for real-time Agmarknet updates
DATA_GOV_IN_API_KEY=your_government_api_key_here

# 4. TELEGRAM ALERTS ENGINE
# Your official Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 5. WHATSAPP ALERTS ENGINE
# Your WhatsApp API Gateway Key (Twilio, Ultramsg, or Chat-API)
WHATSAPP_API_KEY=your_whatsapp_gateway_key_here
