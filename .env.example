# =========================================================================
#  UP MANDI ENTERPRISE - ENVIRONMENT CONFIGURATION
# =========================================================================
# Copy this file to .env and fill in your own values.
# Never commit .env, access tokens, passwords, or screenshots of credentials.

ENVIRONMENT=production

# Database (the Docker Compose volume persists this SQLite file).
DATABASE_URL=sqlite:////app/runtime/mandi_v2.db

# Generate with: openssl rand -hex 32
JWT_SECRET=

# The initial admin is created only when ADMIN_PASSWORD is configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Comma-separated browser origins allowed to call the API.
# Example: https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://abhishekagrahari307-max.github.io

# Official Open Government Data / AGMARKNET integration.
# Register at https://data.gov.in/ and keep the key private.
DATA_GOV_IN_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional authorised government price feeds.
# A mandi price is published ONLY when at least three configured government
# price feeds report the same market, commodity, date and modal price, so at
# least one of these feeds is required alongside data.gov.in and AGMARKNET.
# These URLs/keys must be issued by e-NAM / UP e-Mandi to an approved integrator.
ENAM_TRADE_FEED_URL=
ENAM_TRADE_API_KEY=
UP_EMANDI_TRADE_FEED_URL=
UP_EMANDI_TRADE_API_KEY=

# Optional authorised e-NAM lot feed supplied to an approved integrator.
# Do not put e-NAM usernames/passwords here; no logged-in portal is scraped.
ENAM_AUCTION_FEED_URL=
ENAM_AUCTION_API_KEY=

# Public government portals read by the pipeline (no key required):
#   AGMARKNET               https://agmarknet.gov.in/home
#   UP Mandi Parishad       https://dashboard.mandiprojects.in/MandiDetails.aspx
#   UP Krishi Vipran        https://www.upkrishivipran.in/Default.aspx  (state benchmark only)

# Set to 1 to skip all outbound portal calls (used by offline/CI refreshes).
SKIP_EXTERNAL_FETCH=

# Optional OpenRouter AI Mandi Assistant.
# Create a key at https://openrouter.ai/ and keep it only on the backend.
# Never paste this key into index.html or browser JavaScript.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_SITE_URL=https://abhishekagrahari307-max.github.io/mandi/
OPENROUTER_APP_NAME=UP Mandi Dashboard
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_TOKENS=700

# Optional alert integrations.
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
