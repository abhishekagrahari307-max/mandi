# =========================================================================
#  UP MANDI ENTERPRISE - ENVIRONMENT CONFIGURATION
# =========================================================================
# Copy this file to .env and fill in your own values.
# Never commit .env, access tokens, passwords, or screenshots of credentials.

ENVIRONMENT=production

# Database (the Docker Compose volume persists this SQLite file).
DATABASE_URL=sqlite:////app/runtime/mandi_v2.db

# Generate with: openssl rand -hex 32
JWT_SECRET=

# The initial admin is created only when ADMIN_PASSWORD is configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Comma-separated browser origins allowed to call the API.
# Example: https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Government data API integration.
DATA_GOV_IN_API_KEY=

# Optional alert integrations.
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=
